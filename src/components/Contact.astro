---
import Mail from "../assets/mail.svg";
import Phone from "../assets/phone.svg";
import MapPin from "../assets/map-pin.svg";
---

<section id="contact">
  <div class="contact-card">
    <h3>Coordonnées</h3>

    <div class="contact-item">
      <MapPin />
      <div>
        <p class="label">Adresse</p>
        <p>10 bis rue Eugène Engrand<br />62260 Cauchy à la Tour</p>
      </div>
    </div>

    <div class="contact-item">
      <Phone />
      <div>
        <p class="label">Téléphone</p>
        <a href="tel:0321651020" class="contact-link">03 21 65 10 20</a>
      </div>
    </div>

    <div class="contact-item">
      <Mail />
      <div>
        <p class="label">Email</p>
        <a href="mailto:simon.colliez@wanadoo.fr" class="contact-link"
          >simon.colliez@wanadoo.fr</a
        >
      </div>
    </div>

    <div>
      <p>Pour obtenir des partitions, n’hésitez pas à envoyer un email</p>
    </div>
  </div>
</section>

<style>
  #contact {
    padding: 3rem 1rem;
    display: flex;
    justify-content: center;
    color: #fff;
  }

  .contact-card {
    background: white;
    color: #2c2e7c;
    border-radius: 1rem;
    box-shadow: rgba(0, 0, 0, 0.16) 0px 1px 4px;
    padding: 2rem;
    max-width: 700px;
    width: 100%;
  }

  h3 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .contact-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .label {
    font-weight: bold;
    margin-bottom: 0.25rem;
  }

  .contact-link {
    color: #2c2e7c;
    text-decoration: none;
  }

  .contact-link:hover {
    text-decoration: underline;
  }
</style>
